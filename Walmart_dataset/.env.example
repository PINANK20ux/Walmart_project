# ==============================================================================
# Sample Environment Variables for Walmart Source Ingestion
# ------------------------------------------------------------------------------
# Copy this file to .env and replace placeholder values with your credentials.
# NEVER commit your actual .env file.
# ==============================================================================

# PostgreSQL Source Database Connection URI
POSTGRES_CONN=postgresql://<username>:<password>@<host>:<port>/<database>?sslmode=require

# External Integration API Key
K_API_KEY=your_api_key_here
