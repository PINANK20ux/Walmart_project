# ==============================================================================
# Walmart Lakehouse Data Platform - Git Ignore Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CRITICAL: Security, Credentials & Environment Secrets
# ------------------------------------------------------------------------------
# Databricks & dbt credentials (NEVER commit tokens or credentials)
profiles.yml
**/profiles.yml
airflow_dbt_project/walmart_db/profiles.yml

# Whitelist profile sample templates
!profiles.sample.yml
!**/profiles.sample.yml

# Environment variable files containing DB passwords, API keys, & Airflow secrets
.env
.env.*
*.env
Walmart_dataset/.env
airflow_dbt_project/.env

# Whitelist environment templates
!.env.example
!**/.env.example
!.env.sample
!**/.env.sample

# Sensitive certificates, keys, and tokens
*.pem
*.key
*.cert
*.crt
*.p12
*.pfx
*credentials*.json
id_rsa
id_ed25519

# ------------------------------------------------------------------------------
# 2. Apache Airflow Execution State & Configs
# ------------------------------------------------------------------------------
# Airflow configuration and local database state
airflow.cfg
**/airflow.cfg
airflow.db
**/airflow.db
*.pid
standalone_admin_password.txt
webserver_config.py

# ------------------------------------------------------------------------------
# 3. Docker & Local Service Overrides
# ------------------------------------------------------------------------------
.docker/
docker-compose.override.yml
*.override.yaml
*.override.yml

# ------------------------------------------------------------------------------
# 4. dbt Build Artifacts, Packages & Execution Logs
# ------------------------------------------------------------------------------
# Compiled models, target directory, catalog, and manifests
target/
**/target/

# Downloaded dbt dependencies and packages
dbt_packages/
**/dbt_packages/

# Execution logs
logs/
**/logs/
*.log
dbt.log

# dbt anonymous user tracking config
.user.yml
**/.user.yml

# ------------------------------------------------------------------------------
# 5. Python & Virtual Environments
# ------------------------------------------------------------------------------
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual environments
.venv/
venv/
env/
ENV/

# Testing & coverage artifacts
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# ------------------------------------------------------------------------------
# 6. Database / Local Dumps / Large Intermediate Datasets
# ------------------------------------------------------------------------------
*.sqlite
*.sqlite3
*.db
*.dump
*.sql.gz

# ------------------------------------------------------------------------------
# 7. Operating System & Editor Metadata
# ------------------------------------------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# JetBrains / Eclipse / Others
.idea/
*.sublime-workspace

# VS Code workspace state (keep shared workspace settings)
.vscode/*
!.vscode/settings.json

# Temporary & scratch files
*.tmp
*.temp
*.bak
*.swp
*~
scratch/
