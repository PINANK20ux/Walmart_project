# ==============================================================================
# Sample Environment Variables for Apache Airflow Orchestration
# ------------------------------------------------------------------------------
# Copy this file to .env in airflow_dbt_project/ and fill in the required values.
# NEVER commit your actual .env file.
# ==============================================================================

# Airflow User ID (on Linux/macOS: run `id -u` to find your UID, default is 50000)
AIRFLOW_UID=50000

# Airflow Fernet Key (used to encrypt credentials in the metadata database)
# Generate a new Fernet key using Python:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=your_fernet_key_here

# Optional: Airflow Project Directory Mount
AIRFLOW_PROJ_DIR=.

# Databricks Lakehouse Credentials (used by orchestrate DAG)
DATABRICKS_HOST=https://your-databricks-instance.cloud.databricks.com
DATABRICKS_TOKEN=dapi_your_databricks_token_here
DATABRICKS_JOB_ID=123456789012345
